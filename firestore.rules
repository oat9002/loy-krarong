rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validKrathong(d) {
      return d.keys().hasOnly(['name', 'wish', 'color', 'photo', 't', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.wish is string && d.wish.size() > 0 && d.wish.size() <= 300
        && d.color is string && d.color.size() <= 16
        && d.t is int
        && (d.photo == null || (d.photo is string && d.photo.size() <= 450000));
    }

    match /rooms/{room} {
      allow read: if room.size() >= 6;
      allow create, update: if room.size() >= 6
        && request.resource.data.keys().hasOnly(['title'])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 40;
      allow delete: if false;
    }

    match /rooms/{room}/krathongs/{id} {
      allow read: if room.size() >= 6;
      allow create: if room.size() >= 6 && validKrathong(request.resource.data);
      allow update, delete: if false;
    }
  }
}
